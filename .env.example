# Copy this file to .env and fill in your key (never commit .env itself).

# --- Provider selection ---
# "groq" or "openrouter" — both have free tiers and speak the OpenAI chat-completions format.
LLM_PROVIDER=groq

# --- Groq (https://console.groq.com/keys) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- OpenRouter (https://openrouter.ai/keys) — alternative free provider ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Orchestrator behavior ---
MAX_REVISION_LOOPS=2
