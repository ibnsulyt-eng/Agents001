# Copy this file to .env and fill in your key (never commit .env itself).

# --- Provider selection ---
# "groq" or "openrouter" — both have free tiers and speak the OpenAI chat-completions format.
LLM_PROVIDER=groq

# --- Groq (https://console.groq.com/keys) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- OpenRouter (https://openrouter.ai/keys) — alternative free provider ---
# Free-tier model availability on OpenRouter is volatile — models get pulled from the
# free pool with no warning. Comma-separate a fallback chain (tried in order; a 404
# "unavailable" skips straight to the next one, a 429 rate-limit retries in place) —
# leave blank to use the built-in defaults in config.py.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# --- Orchestrator behavior ---
MAX_REVISION_LOOPS=2

# --- TikTok Live monitoring (monitor_main.py) ---
# Comma-separated usernames (with or without @) to watch concurrently.
TIKTOK_WATCHLIST=
# How often / how many comments before flushing the ambiguous batch to the LLM.
MONITOR_BATCH_SECONDS=10
MONITOR_BATCH_SIZE=15
# SQLite file all events (comments/gifts/joins/likes) get logged to.
MONITOR_LOG_DB=monitor.sqlite3
# Comma-separated terms that get flagged instantly by the free rule-based filter,
# without waiting on/spending an LLM call.
MONITOR_BANNED_KEYWORDS=

# --- Alerts on flagged comments (optional) ---
# none | discord | telegram
ALERT_PROVIDER=none
ALERT_DISCORD_WEBHOOK_URL=
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
